<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaz de escritorio (Avalonia) y raíz de composición. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BlackJack.Desktop</RootNamespace>
    <AssemblyName>BlackJack</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="imagenes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackJack.Core\BlackJack.Core.csproj" />
    <ProjectReference Include="..\BlackJack.Infrastructure\BlackJack.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!-- Dependencia transitiva de Avalonia.FreeDesktop fijada a la versión que corrige GHSA-xrw6-gwf8-vvr9. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

</Project>
